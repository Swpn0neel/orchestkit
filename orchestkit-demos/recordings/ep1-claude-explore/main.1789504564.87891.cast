[109.289354, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[9A \u001b[3G\u001b[38;2;153;153;153mSearched for \u001b[1m1\u001b[22m pattern (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[15C\u001b[2B\u001b[38;2;153;153;153mChecking uncommitted changes...… 11/12 · 16s · ↓\u001b[65G471 tokens)\u001b[39m\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[35G\u001b[38;2;255;193;7mYou've\u001b[42Gused\u001b[47G96%\u001b[51Gof\u001b[54Gyour\u001b[59Gsession\u001b[67Glimit\u001b[73G·\u001b[75Gresets\u001b[82G1am\u001b[86G(Asia/Jerusalem)\u001b[103G·\u001b[105G/upgrade\u001b[114Gto\u001b[117Gkeep\u001b[122Gusing\u001b[128GClaude\u001b[135GCode\u001b[39m\r\r\n\u001b[2C\u001b[4A\u001b[?25h\u001b[?2026l"]
[109.310589, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[4B\r\u001b[2C\u001b[8A\u001b[38;2;228;144;112mChanneling…\u001b[66G\u001b[38;2;153;153;153m96\u001b[39m\r\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[2C\u001b[4A\u001b[?25h\u001b[?2026l\u001b]0;◑ show/ep1-claude-explore · wt\u0007"]
