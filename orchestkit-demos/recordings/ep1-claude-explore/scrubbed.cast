[16.592794, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[4B\r\u001b[8A\u001b[38;2;255;255;255m\u23fa\u001b[3G\u001b[39mSkill pages are generated, never hand-written: \u001b[38;2;177;185;249mnpm run build\u001b[39m runs \u001b[38;2;177;185;249mscripts/build-plugins.sh\u001b[39m,\u001b[95Gwhich\u001b[101Gat\u001b[104Gline\u001b[109G735\u001b[113Gcalls\u001b[119G\u001b[38;2;177;185;249mscripts/build-docs.sh\u001b[39m;\r\u001b[1B  that script wipes the reference output dirs (\u001b[38;2;177;185;249m:39\u001b[39m) and runs \u001b[38;2;177;185;249mscripts/_build-docs-generate.py\u001b[39m (\u001b[38;2;177;185;249m:44\u001b[39m), which turns each\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249msrc/skills/<name>/SKILL.md\u001b[30G\u001b[39minto\u001b[35Gan\u001b[38GMDX\u001b[42Gpage\u001b[47Gfor\u001b[51GFumadocs.\r\u001b[1B\u001b[K\r\u001b[1B  \u250c\u2500\u001b[6Gnpm\u001b[10Grun\u001b[14Gbuild\u001b[20G\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[1B  \u2502 build-plugins.sh \u2500\u2500\u25b6 build-docs.sh \u2500\u2500\u25b6 _build-docs-generate.py\u2502\u001b[K\r\u001b[2C\u001b[1B\u2502                       (rm -rf reference/)        \u2502            \u2502\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5Gsrc/skills/*/SKILL.md\u001b[27G\u2500\u2500\u2500\u2500"]
[16.593896, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518            \u2502\u001b[K\r\r\n\u001b[3G\u2502\u001b[12G\u2514\u2500\u2500\u25b6\u001b[17Gdocs/site/content/docs/reference/skills/*.mdx\u001b[63G\u2705\u001b[67G\u2502\r\r\n\u001b[3G\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\r\n\r\r\n\u001b[4G \u001b[3G\u26a0\ufe0f\u001b[6GRun\u001b[10G\u001b[38;2;177;185;249mbuild-docs.sh\u001b[24G\u001b[39monly\u001b[29Gvia\u001b[33G\u001b[38;2;177;185;249mnpm\u001b[37Grun\u001b[41Gbuild\u001b[39m:\u001b[48Gthe\u001b[52Glab\u001b[56Gmanifest\u001b[65Gand\u001b[69Gsearch\u001b[76Gindex\u001b[82Gare\u001b[86Gsibling\u001b[94Gsteps\u001b[100Gin\u001b[103G\u001b[38;2;177;185;249mbuild-plugins.sh\u001b[39m,\u001b[121Gso\u001b[124Grunning\u001b[132Git\u001b[135Galone\r\r\n\u001b[3Gcreates\u001b[11Gdrift.\r\r\n\r\r\n\u001b[38;2;215;119;87m\u00b7\u001b[3G\u001b[38;2;230;149;117mChanneling\u2026\u001b[38;2;215;119;87m \u001b[38;2;153;153;153m(Checking\u001b[25Guncommitted\u001b[37Gchanges...\u2026\u001b[49G11/12\u001b[55G\u00b7\u001b[57G16s\u001b[61G\u00b7\u001b[63G\u2193\u001b[65G521\u001b[69Gtokens)\u001b[39m\r\r\n\u001b[38;2;153;153;153m \u001b[3G\u23bf\u001b[5G\u00a0Tip:\u001b[11GSee\u001b[15Gan\u001b[18Gartifact\u001b[27Gyou'd\u001b[33Glike\u001b"]
